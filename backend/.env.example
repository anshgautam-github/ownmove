# ---------------------------------------------------------------------------
# Backend environment. Copy to `.env` and fill in.
# NEVER commit the real .env — it holds the service-role key.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=console

# Comma-separated list of allowed browser origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Supabase --------------------------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Project Settings -> API -> service_role. BYPASSES ROW LEVEL SECURITY.
# Server-side only. Never ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings -> API -> JWT Settings -> JWT Secret.
# Required to verify the tokens the frontend forwards.
SUPABASE_JWT_SECRET=your-jwt-secret

# Project Settings -> Database -> Connection string (for pgvector work).
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- AI providers -----------------------------------------------------------
# Required for the Profile Analysis feature (backend/app/profile_analysis).
# https://platform.openai.com/api-keys
# Without this set, Profile Analysis still works end-to-end using a
# deterministic mock generator (no external call) — see
# profile_analysis/services/generators/factory.py. Add a real key here to
# switch it over to OpenAI + LangChain/LangGraph with no frontend changes.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=openai
DEFAULT_CHAT_MODEL=gpt-4o-mini

# Used by the "For You" recommendation engine (backend/app/services/
# recommendation_*.py) to embed profiles/opportunities. Local model, no API
# key — runs in-process via `sentence-transformers` (requirements.txt).
# Dimension MUST match the `vector(384)` columns on public.profiles.
# embedding / public.opportunities.embedding; changing the model to one
# with a different output size means changing those columns too.
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# Optional: pins where the model weights get cached on disk (maps to the
# HF_HOME env var huggingface_hub reads). Leave blank to use the library
# default (~/.cache/huggingface) — set this in Docker images that pre-bake
# the model at build time.
EMBEDDING_MODEL_CACHE_DIR=

# Optional: a stronger/pricier model just for Profile Analysis. Leave blank
# to reuse DEFAULT_CHAT_MODEL.
PROFILE_ANALYSIS_MODEL=

# --- Recommendations ("For You") --------------------------------------------
RECOMMENDATION_CANDIDATE_LIMIT=50
RECOMMENDATION_RESULT_LIMIT=24
RECOMMENDATION_INLINE_BACKFILL_LIMIT=20
RECOMMENDATION_REFRESH_BACKFILL_LIMIT=200

# --- Background jobs (not used yet) ----------------------------------------
REDIS_URL=
ENABLE_BACKGROUND_WORKERS=false

# --- Rate limiting -----------------------------------------------------------
# Redis-backed, distributed, atomic rate limiting for our own FastAPI
# endpoints (see backend/RATE_LIMITING.md). Deliberately separate from
# Supabase Auth's own rate limiting on signup/login/OAuth/password-recovery
# (configured in the Supabase dashboard, not here). Uses the SAME REDIS_URL
# as ENABLE_BACKGROUND_WORKERS above. If REDIS_URL is left blank (or Redis
# is briefly unreachable), behavior is an explicit fail-open/fail-closed
# policy per endpoint category — see RATE_LIMIT_FAIL_OPEN_* below — not a
# crash or a silent bypass.
RATE_LIMIT_ENABLED=true

# How many trusted reverse-proxy hops sit in front of this service and
# themselves append (not just relay) the real client IP to
# X-Forwarded-For. 0 (default) = trust nothing but the direct TCP peer and
# ignore X-Forwarded-For entirely — correct until you've confirmed the real
# deployment topology. Setting this wrong in the trusting direction lets a
# client forge X-Forwarded-For and dodge IP-based rate limiting.
TRUSTED_PROXY_HOPS=0

# Fail-open (true) lets requests through, logged at ERROR, if Redis is
# unreachable. Fail-closed (false) rejects with 503 instead. Ordinary
# reads/writes default to open (a cache outage shouldn't take the API
# down); the AI/expensive tier below defaults to CLOSED (unmetered LLM
# spend is the bigger risk there).
RATE_LIMIT_FAIL_OPEN_DEFAULT=true
RATE_LIMIT_FAIL_OPEN_AI=false

# Ordinary authenticated reads/writes (requests per minute, per user).
RATE_LIMIT_AUTH_READ_PER_MINUTE=120
RATE_LIMIT_AUTH_WRITE_PER_MINUTE=30

# AI/LLM/embedding-backed endpoints (Profile Analysis, Career Roadmap,
# Career Simulation, AI Coach, Recommendations) — the strictest tier,
# layered per-user AND per-IP so creating extra accounts doesn't bypass it.
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_AI_PER_DAY=100
RATE_LIMIT_AI_IP_PER_MINUTE=30
RATE_LIMIT_AI_IP_PER_DAY=300

# Reserved for any future unauthenticated route (nothing currently uses
# this — every real route requires an authenticated user, and /health is
# exempt from rate limiting altogether).
RATE_LIMIT_PUBLIC_PER_MINUTE=60

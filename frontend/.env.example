# Copy to .env and fill in. Vite only exposes vars prefixed with VITE_.
# Never put secrets here — everything in this file ships to the browser.

# Supabase: Project Settings -> API
# Google sign-in is a Supabase Auth provider (Authentication -> Providers),
# not a separate client-id/redirect-uri pair — nothing else to configure
# here for it.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend. Required — the Career AI dashboards (Profile Analysis,
# Career Roadmap, Career Simulation, AI Coach) call this directly from the
# browser and will show a clear "not configured" error if it's missing,
# rather than silently falling back to a local dev URL.
VITE_API_BASE_URL=http://localhost:8000
